<?xml version="1.0"?>
<package format="3">
  <name>apriltag_dataset_collector</name>
  <version>0.1.0</version>
  <description>Standalone AprilTag PnP dataset collection GUI and CLI for FinsROV.</description>

  <maintainer email="support@openai.com">FinsSim contributors</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
