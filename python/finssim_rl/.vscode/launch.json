    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Attach (debugpy 10092)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 10092
            },
            "justMyCode": false
        },
        {
            "name": "Python: Export to ONNX",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.export_to_onnx", // 对应 -m scripts.export_to_onnx
            "args": [
                "--config", "ppo_control_for_pose",
                "--exp-name", "ControlForPoseTest"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }

    ]
}